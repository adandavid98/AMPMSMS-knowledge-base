# AMPM Service POS Assistant - Environment Configuration

# Google Gemini API (Default provider & embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API (Alternate fast provider)
GROQ_API_KEY=your_groq_api_key_here

# Tavily API (Web Fallback)
TAVILY_API_KEY=your_tavily_api_key_here

# OpenRouter API (Access to 20+ Free LLMs like Llama 3.3, Gemma 2, Mistral)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Ollama Host (Optional local LLM server)
OLLAMA_HOST=http://localhost:11434

# Supabase Cloud Vector DB (Optional - system uses local ChromaDB if empty)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Langfuse Observability & Telemetry (Optional)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Pipeline Features
USE_DOCLING_PARSER=true
USE_HYBRID_SEARCH=true

# Access Protection Passphrase (Optional shared store code)
REQUIRE_AUTH=true
ALLOWED_EMAIL_DOMAIN=@ampmservice.com
APP_PASSPHRASE=AMPM$$16520

# Defaults
DEFAULT_LLM_PROVIDER=gemini
CHROMA_PERSIST_DIR=.chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=50
